{
  "name": "genshin-music",
  "engines": {
    "node": ">=24.18.0"
  },
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npx serve@latest build",
    "preview:sky": "npx serve@latest build/skyMusic",
    "preview:genshin": "npx serve@latest build/genshinMusic",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:sky": "cross-env PUBLIC_GAME=sky npm run check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fix": "eslint --fix . && prettier --write .",
    "format:check": "prettier --check .",
    "check:translations": "node ./scripts/checkTranslations.js",
    "generate:english-locale": "node ./scripts/generateEnglishLocale.js",
    "build:sky": "node ./scripts/buildApp.js Sky",
    "build:sky:analyze": "cross-env ANALYZE=true npm run build:sky",
    "build:genshin": "node ./scripts/buildApp.js Genshin",
    "build:genshin:analyze": "cross-env ANALYZE=true npm run build:genshin",
    "build:sky-no-root": "node ./scripts/buildApp.js Sky false",
    "build:genshin-no-root": "node ./scripts/buildApp.js Genshin false",
    "build:all": "node ./scripts/buildApp.js All",
    "build:all-no-root": "node ./scripts/buildApp.js All false",
    "dev:sky": "node ./scripts/startApp.js Sky",
    "dev:genshin": "node ./scripts/startApp.js Genshin",
    "test": "npm run test:genshin && npm run test:sky",
    "test:genshin": "cross-env PUBLIC_GAME=genshin vitest run",
    "test:sky": "cross-env PUBLIC_GAME=sky vitest run",
    "test:update-fixtures": "cross-env UPDATE_FIXTURES=true npm run test"
  },
  "dependencies": {
    "@insertish/zangodb": "^1.0.12-nomemo",
    "@mediabunny/mp3-encoder": "1.58.0",
    "@spotify/basic-pitch": "^1.0.1",
    "@tonejs/midi": "^2.0.28",
    "@types/fuzzy-search": "^2.1.5",
    "color": "^5.0.3",
    "events": "^3.3.0",
    "fflate": "^0.8.3",
    "fontfaceobserver": "^2.3.0",
    "fuzzy-search": "^3.2.1",
    "i18next": "^26.4.2",
    "is-mobile": "^5.0.0",
    "lodash.clonedeep": "^4.5.0",
    "mediabunny": "1.58.0",
    "pixi.js": "^8.21.0",
    "semver": "^7.8.5",
    "svelte-awesome-color-picker": "^4.1.3",
    "worker-timers": "^8.0.34"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/fa6-regular": "1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/lucide": "^1.2.133",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/color": "^4.2.1",
    "@types/fontfaceobserver": "^2.1.3",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/semver": "^7.8.0",
    "cli-color": "^2.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "fs-extra": "^11.4.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.104.1",
    "serwist": "^9.5.12",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-icons": "^24.0.0",
    "url-join": "^5.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
